# ─────────────────────────────────────────────────────────────────────────────
# Inbox — variables d'environnement
#
# Copier ce fichier en `.env` et compléter. L'API valide toutes ces variables
# au démarrage (apps/api/src/config/env.ts) et refuse de démarrer si l'une
# d'elles manque ou est mal formée.
#
# Aucun secret réel ne doit être commité. `.env` est ignoré par Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Exécution ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Origines publiques. En production, APP_URL doit être en HTTPS.
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Origines autorisées par CORS, séparées par des virgules. Vide = APP_URL seule.
CORS_ORIGINS=http://localhost:3000

# ── Base de données ──────────────────────────────────────────────────────────
# Le service `postgres` du docker-compose de développement.
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox?schema=public

# ── Secrets (32 caractères minimum, trois valeurs DIFFÉRENTES) ───────────────
# Générer : openssl rand -base64 48
JWT_SECRET=changez-moi-openssl-rand-base64-48-aaaaaaaaaaaa
REFRESH_SECRET=changez-moi-openssl-rand-base64-48-bbbbbbbbbbbb
CSRF_SECRET=changez-moi-openssl-rand-base64-48-cccccccccccc
# Domaine des cookies en production (ex. .inbox.cm). Laisser vide en local.
COOKIE_DOMAIN=

# ── Images (Cloudinary) ──────────────────────────────────────────────────────
# Facultatif en développement : un stockage disque local prend le relais.
# Obligatoire en production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── E-mails (Resend) ─────────────────────────────────────────────────────────
# Sans clé, les e-mails sont écrits dans la console au lieu d'être envoyés.
# Obligatoire en production.
RESEND_API_KEY=
MAIL_FROM="Inbox <contact@inbox.cm>"
MAIL_REPLY_TO=contact@inbox.cm

# ── Paiements ────────────────────────────────────────────────────────────────
# MOCK fournit un espace de paiement de démonstration, utilisable tant qu'aucun
# compte Maviance ni Stripe n'est ouvert. Il est REFUSÉ en production.
PAYMENT_PROVIDER_MOBILE=MOCK
PAYMENT_PROVIDER_CARD=MOCK

# Maviance Smobilpay (MTN MoMo, Orange Money)
MAVIANCE_BASE_URL=
MAVIANCE_PUBLIC_TOKEN=
MAVIANCE_SECRET_KEY=
MAVIANCE_MERCHANT_ID=

# Stripe (carte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Mesure d'audience (Umami auto-hébergé, sans cookie) ──────────────────────
UMAMI_SCRIPT_URL=http://localhost:3002/script.js
UMAMI_WEBSITE_ID=

# ── Identité de l'éditeur ────────────────────────────────────────────────────
# Ces valeurs alimentent les mentions légales, les CGU, les CGV et les reçus.
# Elles ne sont écrites en dur nulle part : à l'immatriculation de la société,
# il suffit de les changer et de publier une nouvelle version des documents.
PUBLISHER_KIND=INDIVIDUAL
PUBLISHER_NAME=Flavien Noponkoue
PUBLISHER_LEGAL_FORM=
PUBLISHER_CAPITAL=
PUBLISHER_RCCM=
PUBLISHER_NIU=
PUBLISHER_ADDRESS=2 avenue Robert Schuman, 51100 Reims, France
PUBLISHER_EMAIL=contact@inbox.cm
PUBLISHER_PHONE=
PUBLICATION_DIRECTOR=Flavien Noponkoue
PRIVACY_CONTACT_EMAIL=donnees@inbox.cm
ABUSE_CONTACT_EMAIL=abus@inbox.cm
# Délégué à la protection des données, si désigné.
DPO_NAME=
DPO_EMAIL=

# ── Hébergeur (mention obligatoire) ──────────────────────────────────────────
HOST_NAME=OVH SAS
HOST_ADDRESS=2 rue Kellermann, 59100 Roubaix, France
HOST_COUNTRY=France
HOST_WEBSITE=https://www.ovhcloud.com

# ── Front (Nuxt) ─────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Docker Compose (développement) ───────────────────────────────────────────
POSTGRES_USER=inbox
POSTGRES_PASSWORD=inbox
POSTGRES_DB=inbox
UMAMI_APP_SECRET=changez-moi-openssl-rand-base64-32
